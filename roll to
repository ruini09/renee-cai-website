<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Hi, I'm RENEE!</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg: #8295ab;
      --blue: #3f72c2;
      --white: #ffffff;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: var(--bg);
      color: var(--white);
    }

    /* Full-screen hero */
    .hero {
      position: relative;
      width: 100%;
      height: 100vh;
      height: 100svh;
      min-height: 500px;
      overflow: hidden;
      isolation: isolate;
      background:
        radial-gradient(
          circle at center,
          rgba(207, 224, 243, 0.42),
          transparent 55%
        ),
        linear-gradient(135deg, #9baabb, #7188a2);
    }

    /* Technical grid */
    .hero::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background-image:
        linear-gradient(
          rgba(255, 255, 255, 0.08) 1px,
          transparent 1px
        ),
        linear-gradient(
          90deg,
          rgba(255, 255, 255, 0.08) 1px,
          transparent 1px
        );
      background-size: 45px 45px;
      mask-image: linear-gradient(
        to bottom,
        black,
        transparent 95%
      );
      pointer-events: none;
    }

    /* Navigation bar */
    .navbar {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 82px;
      padding: 0 5%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255, 255, 255, 0.25);
      background: rgba(75, 98, 125, 0.15);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      z-index: 10;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      color: white;
      text-decoration: none;
      font-size: 12px;
      font-weight: bold;
      letter-spacing: 3px;
    }

    /* Blue circular R logo */
    .logo {
      width: 31px;
      height: 31px;
      flex-shrink: 0;
      border-radius: 50%;
      background: var(--blue);
      display: flex;
      justify-content: center;
      align-items: center;
      color: white;
      font-family: Georgia, serif;
      font-size: 22px;
      font-style: italic;
      box-shadow: 0 0 20px rgba(63, 114, 194, 0.4);
    }

    .nav-link {
      color: white;
      text-decoration: none;
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
      position: relative;
    }

    .nav-link::after {
      content: "";
      position: absolute;
      bottom: -7px;
      left: 0;
      width: 100%;
      height: 1px;
      background: white;
      transform: scaleX(0);
      transform-origin: right;
      transition: transform 0.3s ease;
    }

    .nav-link:hover::after,
    .nav-link:focus-visible::after {
      transform: scaleX(1);
      transform-origin: left;
    }

    /* Decorative circular technology motif */
    .orbit {
      position: absolute;
      width: min(75vw, 850px);
      aspect-ratio: 1;
      border: 1px solid rgba(255, 255, 255, 0.18);
      border-radius: 50%;
      left: 50%;
      top: 52%;
      transform: translate(-50%, -50%);
      box-shadow:
        0 0 0 45px rgba(255, 255, 255, 0.025),
        0 0 0 90px rgba(255, 255, 255, 0.02);
      pointer-events: none;
      z-index: -1;
    }

    .orbit::before,
    .orbit::after {
      content: "";
      position: absolute;
      width: 5px;
      height: 5px;
      background: white;
      border-radius: 50%;
      box-shadow: 0 0 15px white;
    }

    .orbit::before {
      top: 18%;
      left: 16%;
    }

    .orbit::after {
      bottom: 17%;
      right: 13%;
    }

    /* Centered main title */
    .hero-title {
      position: absolute;
      inset: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      text-align: center;
      padding: 90px 20px;
      z-index: 2;
    }

    .hero-title h1 {
      color: #fff;
      font-family: Impact, "Arial Narrow", sans-serif;
      font-size: clamp(3rem, 10vw, 9rem);
      font-weight: 900;
      letter-spacing: 0.04em;
      line-height: 1.1;
      margin: 0;
      text-shadow: 0 4px 25px rgba(39, 57, 79, 0.12);
    }

    /* Bottom captions */
    .bottom-caption {
      position: absolute;
      left: 5%;
      bottom: 35px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: rgba(255, 255, 255, 0.75);
    }

    .bottom-caption strong {
      font-size: 12px;
      color: white;
      letter-spacing: 1px;
    }

    .side-caption {
      position: absolute;
      right: 5%;
      bottom: 35px;
      writing-mode: vertical-rl;
      font-size: 10px;
      letter-spacing: 3px;
      color: rgba(255, 255, 255, 0.8);
    }

    /* About section */
    .about {
      min-height: 55vh;
      padding: 100px 8%;
      background: #e9eef4;
      color: #24364b;
    }

    .about-label {
      margin-bottom: 20px;
      font-size: 11px;
      letter-spacing: 3px;
      text-transform: uppercase;
    }

    .about h2 {
      max-width: 800px;
      font-size: clamp(36px, 6vw, 76px);
      line-height: 1.05;
      letter-spacing: -2px;
    }

    .about p {
      max-width: 580px;
      margin-top: 25px;
      color: #5e6e80;
      line-height: 1.8;
      font-size: 16px;
    }

    /* Mobile layout */
    @media (max-width: 700px) {
      .navbar {
        height: 68px;
        padding: 0 22px;
      }

      .brand {
        gap: 9px;
        font-size: 10px;
        letter-spacing: 2px;
      }

      .logo {
        width: 29px;
        height: 29px;
        font-size: 20px;
      }

      .nav-link {
        font-size: 10px;
        letter-spacing: 1px;
      }

      .hero-title {
        padding: 70px 20px;
      }

      .hero-title h1 {
        font-size: clamp(2.8rem, 10vw, 5rem);
        line-height: 1.1;
        letter-spacing: 0.02em;
      }

      .orbit {
        width: 110vw;
      }

      .bottom-caption {
        left: 22px;
        bottom: 22px;
        font-size: 8px;
        letter-spacing: 1.5px;
      }

      .bottom-caption strong {
        font-size: 10px;
      }

      .side-caption {
        right: 15px;
        bottom: 22px;
        font-size: 8px;
        letter-spacing: 2px;
      }

      .about {
        padding: 75px 25px;
      }

      .about h2 {
        letter-spacing: -1px;
      }

      .about p {
        font-size: 15px;
      }
    }

    /* Smaller phones */
    @media (max-width: 380px) {
      .navbar {
        padding: 0 15px;
      }

      .brand {
        gap: 7px;
        font-size: 9px;
        letter-spacing: 1.5px;
      }

      .nav-link {
        font-size: 9px;
      }

      .hero-title h1 {
        font-size: 2.7rem;
      }
    }

    /* Respect reduced-motion preferences */
    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *,
      *::before,
      *::after {
        transition: none !important;
      }
    }
  </style>
</head>

<body>
  <main class="hero" id="home">

    <!-- Navigation -->
    <nav class="navbar" aria-label="Main navigation">
      <a class="brand" href="#home" aria-label="Renee Cai home">
        <span class="logo" aria-hidden="true">R</span>
        <span>RENEE CAI</span>
      </a>

      <a class="nav-link" href="#about">
        About Me ↗
      </a>
    </nav>

    <!-- Decorative circle -->
    <div class="orbit" aria-hidden="true"></div>

    <!-- Main greeting -->
    <div class="hero-title">
      <h1>Hi, I'm RENEE!</h1>
    </div>

    <!-- Bottom-left caption -->
    <div class="bottom-caption">
      <span>PERSONAL WEBSITE</span>
      <strong>CREATIVE MIND · CURIOUS SOUL</strong>
    </div>

    <!-- Bottom-right caption -->
    <div class="side-caption" aria-hidden="true">
      ALWAYS EXPLORING
    </div>

  </main>

  <!-- About Me section -->
  <section class="about" id="about">
    <div class="about-label">01 / ABOUT ME</div>

    <h2>
      Welcome to my universe.
    </h2>

    <p>
      One mind, countless ideas. Explore my interests,
      creative projects, and experiments as I build my
      own corner of the digital world.
    </p>
  </section>
</body>
</html>
